# SQLite database location (relative to prisma/ directory)
DATABASE_URL="file:./jobhunt.db"

# Default AI provider. Options: mock | openai | anthropic | gemini | openrouter | ollama | custom
AI_PROVIDER="mock"
AI_MODEL="mock"

# Optional real provider keys (leave blank to stay on mock)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""

# Encryption key for the local credential vault & stored API keys.
# Generate a strong one: openssl rand -hex 32
VAULT_KEY="replace-with-a-64-char-hex-key"
